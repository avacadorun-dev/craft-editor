%YAML 1.2
---
# Native port of the pinned MIT Refractor 5.0.0 grammar; see NOTICE.md.
{
  "name": "Scheme",
  "scope": "source.scheme",
  "file_extensions": [
    "scheme",
    "scm"
  ],
  "contexts": {
    "main": [
      {
        "match": "#\\|",
        "scope": "comment.block.scheme",
        "push": "block-comment"
      },
      {
        "match": ";.*",
        "scope": "comment.line.scheme"
      },
      {
        "match": "#;",
        "scope": "comment.block.datum.scheme",
        "push": "datum-comment"
      },
      {
        "match": "\"",
        "scope": "punctuation.definition.string.begin.scheme",
        "push": "string"
      },
      {
        "match": "'[^()\\[\\]#'\\s]+",
        "scope": "constant.other.symbol.scheme"
      },
      {
        "match": "#\\\\(?:[ux][a-fA-F\\d]+\\b|[-a-zA-Z]+\\b|\\S)",
        "scope": "constant.character.scheme"
      },
      {
        "match": "(^|[^\\'`#])(\\(|\\[)((?:begin|case(?:-lambda)?|cond(?:-expand)?|define(?:-library|-macro|-record-type|-syntax|-values)?|defmacro|delay(?:-force)?|do|else|except|export|guard|if|import|include(?:-ci|-library-declarations)?|lambda|let(?:rec)?(?:-syntax|-values|\\*)?|let\\*-values|only|parameterize|prefix|(?:quasi-?)?quote|rename|set!|syntax-(?:case|rules)|unless|unquote(?:-splicing)?|when)(?=[()\\[\\]\\s]|$))",
        "captures": {
          2: "punctuation.section.parens.scheme",
          3: "keyword.control.scheme"
        }
      },
      {
        "match": "(^|[^\\'`#])(\\(|\\[)((?:abs|and|append|apply|assoc|ass[qv]|binary-port\\?|boolean=?\\?|bytevector(?:-append|-copy|-copy!|-length|-u8-ref|-u8-set!|\\?)?|caar|cadr|call-with-(?:current-continuation|port|values)|call\\/cc|car|cdar|cddr|cdr|ceiling|char(?:->integer|-ready\\?|\\?|<\\?|<=\\?|=\\?|>\\?|>=\\?)|close-(?:input-port|output-port|port)|complex\\?|cons|current-(?:error|input|output)-port|denominator|dynamic-wind|eof-object\\??|eq\\?|equal\\?|eqv\\?|error|error-object(?:-irritants|-message|\\?)|eval|even\\?|exact(?:-integer-sqrt|-integer\\?|\\?)?|expt|features|file-error\\?|floor(?:-quotient|-remainder|\\/)?|flush-output-port|for-each|gcd|get-output-(?:bytevector|string)|inexact\\??|input-port(?:-open\\?|\\?)|integer(?:->char|\\?)|lcm|length|list(?:->string|->vector|-copy|-ref|-set!|-tail|\\?)?|make-(?:bytevector|list|parameter|string|vector)|map|max|member|memq|memv|min|modulo|negative\\?|newline|not|null\\?|number(?:->string|\\?)|numerator|odd\\?|open-(?:input|output)-(?:bytevector|string)|or|output-port(?:-open\\?|\\?)|pair\\?|peek-char|peek-u8|port\\?|positive\\?|procedure\\?|quotient|raise|raise-continuable|rational\\?|rationalize|read-(?:bytevector|bytevector!|char|error\\?|line|string|u8)|real\\?|remainder|reverse|round|set-c[ad]r!|square|string(?:->list|->number|->symbol|->utf8|->vector|-append|-copy|-copy!|-fill!|-for-each|-length|-map|-ref|-set!|\\?|<\\?|<=\\?|=\\?|>\\?|>=\\?)?|substring|symbol(?:->string|\\?|=\\?)|syntax-error|textual-port\\?|truncate(?:-quotient|-remainder|\\/)?|u8-ready\\?|utf8->string|values|vector(?:->list|->string|-append|-copy|-copy!|-fill!|-for-each|-length|-map|-ref|-set!|\\?)?|with-exception-handler|write-(?:bytevector|char|string|u8)|zero\\?)(?=[()\\[\\]\\s]|$))",
        "captures": {
          2: "punctuation.section.parens.scheme",
          3: "support.function.scheme"
        }
      },
      {
        "match": "(?i)(^|[()\\[\\]\\s])((?:(?:(?:#d(?:#[ei])?|#[ei](?:#d)?)?(?:(?:[+-]?(?:\\d+(?:/\\d+)|(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[esfdl][+-]?\\d+)?)|[+-](?:inf|nan)\\.0)(?:@(?:[+-]?(?:\\d+(?:/\\d+)|(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[esfdl][+-]?\\d+)?)|[+-](?:inf|nan)\\.0)|(?:[+-](?:(?:\\d+(?:/\\d+)|(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[esfdl][+-]?\\d+)?)|(?:inf|nan)\\.0)?i))?|(?:[+-](?:(?:\\d+(?:/\\d+)|(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[esfdl][+-]?\\d+)?)|(?:inf|nan)\\.0)?i)))|(?:(?:#[box](?:#[ei])?|(?:#[ei])?#[box])(?:(?:[+-]?(?:[0-9a-f]+(?:/[0-9a-f]+)?)|[+-](?:inf|nan)\\.0)(?:@(?:[+-]?(?:[0-9a-f]+(?:/[0-9a-f]+)?)|[+-](?:inf|nan)\\.0)|(?:[+-](?:(?:[0-9a-f]+(?:/[0-9a-f]+)?)|(?:inf|nan)\\.0)?i))?|(?:[+-](?:(?:[0-9a-f]+(?:/[0-9a-f]+)?)|(?:inf|nan)\\.0)?i)))))(?=[()\\[\\]\\s]|$)",
        "captures": {
          2: "constant.numeric.scheme"
        }
      },
      {
        "match": "(^|[()\\[\\]\\s])(#(?:[ft]|false|true))(?=[()\\[\\]\\s]|$)",
        "captures": {
          2: "constant.language.scheme"
        }
      },
      {
        "match": "(^|[^'`#])(\\(|\\[)([-+*%/]|[<>]=?|=>?)(?=[()\\[\\]\\s]|$)",
        "captures": {
          2: "punctuation.scheme",
          3: "keyword.operator.scheme"
        }
      },
      {
        "match": "(^|[^'`#])(\\(|\\[)([^|()\\[\\]'\\s]+|\\|(?:[^\\\\|]|\\\\.)*\\|)(?=[()\\[\\]\\s]|$)",
        "captures": {
          2: "punctuation.scheme",
          3: "entity.name.function.scheme"
        }
      },
      {
        "match": "\\|(?:[^\\\\|]|\\\\.)*\\|",
        "scope": "variable.other.scheme"
      },
      {
        "match": "[()\\[\\]'`]",
        "scope": "punctuation.scheme"
      }
    ],
    "string": [
      {
        "meta_scope": "string.quoted.double.scheme"
      },
      {
        "meta_include_prototype": false
      },
      {
        "match": "\\\\.",
        "scope": "constant.character.escape.scheme"
      },
      {
        "match": "\"",
        "scope": "punctuation.definition.string.end.scheme",
        "pop": true
      }
    ],
    "block-comment": [
      {
        "meta_scope": "comment.block.scheme"
      },
      {
        "meta_include_prototype": false
      },
      {
        "match": "#\\|",
        "push": "block-comment"
      },
      {
        "match": "\\|#",
        "pop": true
      }
    ],
    "datum-comment": [
      {
        "meta_scope": "comment.block.datum.scheme"
      },
      {
        "meta_include_prototype": false
      },
      {
        "match": "\\s+"
      },
      {
        "match": ";.*"
      },
      {
        "match": "#\\|",
        "push": "block-comment"
      },
      {
        "match": "['`,]@?"
      },
      {
        "match": "#\\\\(?:x[a-fA-F0-9]+|[a-zA-Z]+|.)",
        "pop": true
      },
      {
        "match": "\"",
        "set": "datum-string"
      },
      {
        "match": "\\(|\\[",
        "set": "datum-list"
      },
      {
        "match": "[^()\\[\\]\\s]+",
        "pop": true
      }
    ],
    "datum-list": [
      {
        "meta_scope": "comment.block.datum.scheme"
      },
      {
        "meta_include_prototype": false
      },
      {
        "match": "\"",
        "push": "datum-string"
      },
      {
        "match": "#\\\\(?:x[a-fA-F0-9]+|[a-zA-Z]+|.)"
      },
      {
        "match": "#\\|",
        "push": "block-comment"
      },
      {
        "match": "\\(|\\[",
        "push": "datum-list"
      },
      {
        "match": "[)\\]]",
        "pop": true
      }
    ],
    "datum-string": [
      {
        "meta_scope": "comment.block.datum.scheme"
      },
      {
        "meta_include_prototype": false
      },
      {
        "match": "\\\\."
      },
      {
        "match": "\"",
        "pop": true
      }
    ]
  }
}
